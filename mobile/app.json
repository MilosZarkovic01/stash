{
  "expo": {
    "name": "Stash",
    "slug": "stash",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "stash",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stash.app"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-apple-authentication"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
