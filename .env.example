# PostgreSQL (docker-compose default)
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://stash:stash@localhost:5432/stash?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:8081
JWT_SECRET=change-me-in-development
APP_PUBLIC_URL=http://localhost:8081

# Email: console logs messages locally. Set MAIL_TRANSPORT=smtp to send.
MAIL_TRANSPORT=console
MAIL_FROM=stash@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sign in with Apple (required for Apple login; fail clearly if unset)
APPLE_CLIENT_ID=

# Optional HTTP expense classifier. If unset, a low-confidence stub is used.
AI_CLASSIFY_URL=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api
